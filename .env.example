OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# API auth (optional in local/dev — when set, require X-API-Key)
GOVERNED_API_KEY=

# Persistence: leave empty for SQLite; set for Postgres
DATABASE_URL=
SQLITE_PATH=data/governed_finance.db

# Result cache (in-memory LRU MVP; Redis later with same key format)
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=900

CORS_ORIGINS=*
